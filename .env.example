# StudyOS — frontend configuration
# Copy this file to `.env` and fill in your Supabase project values.
# `.env` is git-ignored. Never commit real secrets.
#
#   cp .env.example .env
#
# All VITE_* variables are embedded in the client bundle — they are PUBLIC.
# Never put a service-role key (or anything secret) here.

# --- Required for the real backend -----------------------------------------
# Project Settings → API in the Supabase dashboard.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Optional app metadata ---------------------------------------------------
VITE_APP_NAME=StudyOS
VITE_APP_VERSION=0.1.0

# --- Demo mode ---------------------------------------------------------------
# When VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY are empty, the app runs in
# demo mode: bundled sample data from src/data/ plus localStorage overlays for
# mistakes, study sessions, profile edits and favourites. No network calls.
