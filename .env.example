# StudyOS — frontend configuration
# Copy this file to `.env` and fill in your Supabase project values.
# `.env` is git-ignored. Never commit real secrets.
#
#   cp .env.example .env
#
# All VITE_* variables are embedded in the client bundle — they are PUBLIC.
# Never put a service-role key (or anything secret) here.

# --- Required for the real backend -----------------------------------------
# Project Settings → API in the Supabase dashboard.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Optional app metadata ---------------------------------------------------
VITE_APP_NAME=StudyOS
VITE_APP_VERSION=0.1.0

# --- Demo mode ---------------------------------------------------------------
# When VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY are empty, the app runs in
# demo mode: bundled sample data from src/data/ plus localStorage overlays for
# mistakes, study sessions, profile edits and favourites. No network calls.
# The AI Tutor falls back to its bundled keyword tutor in this mode too.

# ===========================================================================
# Server-side AI configuration (Phase 4) — NOT VITE_*, NOT in the browser
# ===========================================================================
# These are read ONLY by the Supabase Edge Functions (Deno). Set them with:
#
#   supabase secrets set AI_PROVIDER=openai OPENAI_API_KEY=sk-...
#
# The browser never holds a provider key: every AI call goes through an edge
# function authenticated with the student's own JWT, and the service-role key
# stays in Supabase's secrets.
#
# --- Provider (pick one) -----------------------------------------------------
# AI_PROVIDER=openai           # openai | google | anthropic
# OPENAI_API_KEY=              # also works for OpenAI-compatible gateways
# AI_BASE_URL=                 # optional: point openai at a proxy/gateway
# AI_MODEL=gpt-4o-mini
#
# GEMINI_API_KEY=              # AI_PROVIDER=google
# ANTHROPIC_API_KEY=           # AI_PROVIDER=anthropic (no embeddings — hybrid
#                              # search degrades to keyword-only)
#
# --- Embeddings (RAG) --------------------------------------------------------
# The database column is typed once, from the GUC `studyos.embedding_dim`
# (default 1536). The model AND the dimension must agree with the database:
#
#   alter database "<your-db>" set studyos.embedding_dim = '1536';
#   select public.studyos_embedding_dim();      -- what the DB expects
#
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_EMBEDDING_DIM=1536
#
# --- Behaviour knobs ---------------------------------------------------------
# AI_MAX_OUTPUT_TOKENS=1200     # caps answer length (cost control)
# AI_REQUEST_TIMEOUT_MS=45000   # per-request abort; streams stop cleanly
# AI_TOP_K=6                    # retrieved chunks per answer
# AI_DAILY_LIMIT=60             # requests per student per day (server-enforced)
# AI_FEATURE_DAILY_LIMIT=25     # per feature (chat, quiz, flashcards, ...)
# AI_TOOL_PLANNING=rule         # rule (deterministic, default) | llm
#
# --- CORS --------------------------------------------------------------------
# ALLOWED_ORIGINS=https://your-app.vercel.app
